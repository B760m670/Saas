# Журнал обращений к подписке.
#
# Вставляется внутрь блока того домена, на котором стоит панель, — рядом с
# `reverse_proxy`, не вместо него.
#
# Пишет в journald: у него нет прав на каталог, которые можно забыть выдать.
# Отдельный файл аккуратнее, но Caddy, не сумевший открыть файл, не
# стартует, — а на нём держатся панель, приём оплаты и сайт. Для разбора
# одной поломки эта цена не окупается.

log {
	# Токен подписки из адреса вырезается. Без этого журнал превращается в
	# список пропусков к VPN: `/api/sub/<токен>` — это и есть пропуск, а
	# журналы читают, пересылают и прикладывают к обращениям.
	#
	# Форма пути при этом сохраняется, и видно, что просили именно подписку.
	format filter {
		wrap json
		fields {
			request>uri regexp "/api/sub/[^/?]+" "/api/sub/СКРЫТО"
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 32
			}
		}
	}
}
