# Домен кабинета — то, что стоит на сервере сегодня.
#
# Записано с работающей машины, а не придумано: конфиг Caddy живёт только
# там, и при переустановке он набирается по памяти — то есть не набирается.
#
# Сертификат Caddy получает и продлевает сам, поэтому в блоке его нет.

content-treasure-via.online, www.content-treasure-via.online {
	encode gzip

	# Кеш закрыт целиком, и для кабинета это правильный выбор.
	#
	# Страница одна и небольшая (около 60 КБ, сжатая — меньше), а её
	# содержимое — срок подписки и ссылка на неё. Показать вчерашний срок
	# хуже, чем ещё раз скачать шестьдесят килобайт.
	#
	# `no-store` строже, чем `no-cache`: тот разрешает держать копию и
	# переспрашивать, этот запрещает хранить вовсе. Разница в один ответ
	# `304` на открытие — на таком размере она незаметна.
	#
	# **Это не лечит «мини-апп показывает старое».** Telegram держит
	# открытую страницу живой в памяти: свернули и вернулись — она та же,
	# и никакой заголовок тут ни при чём. Помогает полное закрытие.
	header Cache-Control "no-store"

	# Первым делом API, иначе его запросы уедут в `file_server` и получат
	# страницу вместо ответа. Бот слушает только петлю: наружу его
	# выставляет вот эта строка, и другого пути внутрь нет.
	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		root * /var/www/gloria
		file_server
	}
}
