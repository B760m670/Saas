# Расписание копий.

[Unit]
Description=Ежедневная копия баз Gloria VPN

[Timer]
# Ночью по московскому времени: если дамп нагрузит базу, это заметит
# меньше всего людей.
OnCalendar=*-*-* 01:30:00 Europe/Moscow

# Разброс до получаса. Минута в минуту снимают копию все, кто оставил
# настройку по умолчанию, — и все они делят один и тот же диск гипервизора.
RandomizedDelaySec=30m

# Машина была выключена в час ночи — копия снимется при включении, а не
# пропустится до следующей ночи.
Persistent=true

[Install]
WantedBy=timers.target
